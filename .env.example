# Forthasia Health — environment
# Copy to .env.local for development. The public site runs fine with none of
# these set — /api/intake falls back to a console log and Turnstile is skipped.

# Public site
NEXT_PUBLIC_SITE_URL=https://forthasiahealth.com

# --- /api/intake (deferred-item ruling: Resend + Airtable + Turnstile) -----

# Resend — sends the enquiry to the concierge desk
RESEND_API_KEY=
INTAKE_TO_EMAIL=concierge@forthasiahealth.com
INTAKE_FROM_EMAIL="Forthasia Health <intake@forthasiahealth.com>"

# Airtable — interim CRM log (free tier)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Intake

# Cloudflare Turnstile — bot protection (site key is public, secret is not)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
